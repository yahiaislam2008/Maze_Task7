    <!-- Invisible physical trigger, same footprint as the checkered finish
         line above (x:[4.7,5.3], y:[1.95,3.0]), 2cm thick so the robot just
         rolls over it. TouchPlugin needs the Contact system at <world>
         level (already present near the top of this file). <target> is a
         hardcoded model name - two instances here so it works with either
         'robot' or 'burger'. If you ever spawn a robot under a different
         -name, add a matching <plugin> block with that name as <target>. -->
        <model name="finish_trigger">
          <static>false</static>
        
          <pose>5.0 2.475 0.01 0 0 0</pose>
        
          <link name="link">
            <gravity>false</gravity>
        
            <collision name="collision">
              <geometry>
                <box>
                  <size>0.6 1.05 0.002</size>
                </box>
              </geometry>
            </collision>
        
            <sensor name="sensor_contact" type="contact">
              <contact>
                <collision>collision</collision>
              </contact>
            </sensor>
          </link>
        
          <plugin
              filename="gz-sim-touchplugin-system"
              name="gz::sim::systems::TouchPlugin">
            <target>robot</target>
            <namespace>finish_robot</namespace>
            <time>0.05</time>
            <enabled>true</enabled>
          </plugin>
        
          <plugin
              filename="gz-sim-touchplugin-system"
              name="gz::sim::systems::TouchPlugin">
            <target>burger</target>
            <namespace>finish_burger</namespace>
            <time>0.05</time>
            <enabled>true</enabled>
          </plugin>
        </model>
  </world>
</sdf>