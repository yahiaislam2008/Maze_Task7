<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="maze_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="wall_south"><static>true</static>
      <pose>2.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.05 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north"><static>true</static>
      <pose>2.5 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.05 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west"><static>true</static>
      <pose>0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 3.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall only spans y:0-2; y:2-3 is the exit doorway (gate_3) -->
    <model name="wall_east_lower"><static>true</static>
      <pose>5 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 2.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 2.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between corridor 1 and 2, spans x:0-4; x:4-5 gap = gate_1 -->
    <model name="partition_1"><static>true</static>
      <pose>2.5 1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.05 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between corridor 2 and 3, spans x:1-5; x:0-1 gap = gate_2 -->
    <model name="partition_2"><static>true</static>
      <pose>3.0 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 0.05 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>



    <model name="retractable_wall_1">
      <pose>0.5 1 0.25 0 0 0</pose>
      <link name="wall_link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.105</ixx><iyy>0.521</iyy><izz>0.418</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.8 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.05 0.5</size></box></geometry>
          <material><ambient>0.75 0.1 0.1 1</ambient><diffuse>0.75 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="wall_1_joint" type="prismatic">
        <parent>world</parent>
        <child>wall_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0.0</lower><upper>1.0</upper><effort>200</effort><velocity>0.5</velocity></limit>
          <dynamics><damping>5.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>wall_1_joint</joint_name>
        <topic>/model/retractable_wall_1/joint/wall_1_joint/cmd_pos</topic>
        <initial_position>0.0</initial_position>
        <p_gain>60</p_gain>
        <i_gain>0.05</i_gain>
        <d_gain>5</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>200</cmd_max>
        <cmd_min>-200</cmd_min>
      </plugin>
    </model>

    <model name="retractable_wall_2">
      <pose>0.5 2 0 0 0 0</pose>
      <link name="wall_link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.105</ixx><iyy>0.521</iyy><izz>0.418</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.7 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.05 0.5</size></box></geometry>
          <material><ambient>0.75 0.1 0.1 1</ambient><diffuse>0.75 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="wall_2_joint" type="prismatic">
        <parent>world</parent>
        <child>wall_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0.0</lower><upper>1.0</upper><effort>200</effort><velocity>0.5</velocity></limit>
          <dynamics><damping>5.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>wall_2_joint</joint_name>
        <topic>/model/retractable_wall_2/joint/wall_2_joint/cmd_pos</topic>
        <initial_position>5</initial_position>
        <p_gain>60</p_gain>
        <i_gain>0.05</i_gain>
        <d_gain>5</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>200</cmd_max>
        <cmd_min>-200</cmd_min>
      </plugin>
    </model>

